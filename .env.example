# =============================================
# 具身智能日报 — 配置文件
# cp .env.example .env，然后只填 ANTHROPIC_API_KEY 即可启动
# =============================================

# ---------- 必填 ----------
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------- 定时时间（24小时制，本地时间）----------
DAILY_RUN_TIME=08:00

# ---------- 网页端口 ----------
WEB_PORT=5000

# ---------- 邮件（可选，默认关闭）----------
# 如果想同时收邮件，把 SEND_EMAIL 改为 true 并填写下方配置
SEND_EMAIL=false

# Gmail：需先在 Google账号→安全→两步验证→应用专用密码 生成16位密码
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=yourname@gmail.com
# SMTP_PASSWORD=xxxx xxxx xxxx xxxx
# RECIPIENT_EMAIL=yourname@gmail.com
