# =============================================
# 具身智能日报 — 配置文件
# 复制此文件为 .env 并填写你的真实配置
# =============================================

# ---------- Claude API ----------
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------- 邮件 SMTP 配置 ----------
# Gmail 示例（需开启"应用专用密码"）：
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=yourname@gmail.com
#   SMTP_PASSWORD=xxxx xxxx xxxx xxxx   # Gmail 应用密码（16位）
#
# QQ邮箱 示例：
#   SMTP_HOST=smtp.qq.com
#   SMTP_PORT=587
#   SMTP_USER=123456789@qq.com
#   SMTP_PASSWORD=xxxxxxxxxxxxxxxx       # QQ邮箱授权码（非登录密码）
#
# 163邮箱 示例：
#   SMTP_HOST=smtp.163.com
#   SMTP_PORT=465
#   SMTP_USER=yourname@163.com
#   SMTP_PASSWORD=xxxxxxxxxxxxxxxx       # 163邮箱授权码

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# ---------- 收件人 ----------
RECIPIENT_EMAIL=your_email@gmail.com

# ---------- 定时时间（24小时制，本地时间）----------
DAILY_RUN_TIME=08:00

# ---------- 网页端口 ----------
WEB_PORT=5000

# ---------- 调试选项 ----------
# 设为 false 可只保存到网页，不发送邮件（测试用）
SEND_EMAIL=true
